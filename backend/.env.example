PORT=3000
NODE_ENV=development

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=iotdb
DB_POOL_SIZE=10
# Local face registration service; portrait/video enrollment does not use Raspberry Pi.
AI_MODEL_URL=http://127.0.0.1:8000
# Attendance always uses the Raspberry Pi camera and outbound job queue.
RECOGNITION_DEVICE_ID=raspi_cam_01
# Optional absolute directory for alert snapshots; default is backend/uploads.
# Keep this directory persistent across deployments.
# UPLOAD_DIR=/var/lib/driverhub/uploads
# Generate a long random secret, then configure the same key on each Raspberry Pi.
DEVICE_API_KEY=
# Only used by npm run auth:admin; public registration cannot create admins.
ADMIN_USERNAME=ad
ADMIN_PASSWORD=ad
ADMIN_NAME=Administrator
