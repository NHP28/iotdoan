{
  "name": "iot-driver-attendance-be",
  "version": "1.0.0",
  "description": "NestJS MySQL Backend for Driver Attendance and Raspberry Pi Telemetry",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test:admin-alerts": "npm run build && node scripts/verify-admin-alerts.mjs",
    "test:profile-registration": "npm run build && node scripts/verify-profile-registration.mjs",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:init": "node scripts/init-db.js",
    "db:push": "drizzle-kit push",
    "db:face-datasets": "node scripts/migrate-face-datasets.mjs",
    "auth:admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.2.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.1",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
