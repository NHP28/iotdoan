[Unit]
Description=DriverHub Raspberry Pi camera recognition worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/driverhub/ai_model
ExecStart=/home/pi/driverhub/ai_model/.venv/bin/python -u pi_worker.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
