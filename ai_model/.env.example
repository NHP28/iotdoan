# Production: URL of your NestJS API domain, without a trailing slash.
SERVER_URL=http://127.0.0.1:3000/api/v1
DEVICE_ID=raspi_cam_01
# Must match DEVICE_API_KEY on the backend. Never put this key in frontend env.
DEVICE_API_KEY=
CAMERA_INDEX=0
CAPTURE_TIMEOUT=12
SHOW_PREVIEW=false
FACE_DISTANCE_THRESHOLD=0.52
